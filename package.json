{
  "name": "avivas-crafts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx --conditions=react-server scripts/dev.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --project integration --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:pg": "vitest run --project pg",
    "test:e2e": "pnpm build && playwright test --pass-with-no-tests",
    "audit": "pnpm audit --audit-level=high",
    "verify": "pnpm typecheck && pnpm lint && pnpm check:css && pnpm test && pnpm run audit && if [ -n \"$DATABASE_URL_TEST\" ]; then pnpm test:pg; fi",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "admin:role": "tsx --conditions=react-server scripts/admin-role.ts",
    "zone:add": "tsx --conditions=react-server scripts/zone-add.ts",
    "dev:oidc": "tsx --conditions=react-server scripts/oidc-mock.ts",
    "fake-pay:replay": "tsx --conditions=react-server scripts/fake-pay-replay.ts",
    "check:image-metadata": "tsx --conditions=react-server scripts/check-image-metadata.ts",
    "check:css": "tsx --conditions=react-server scripts/check-logical-css.ts",
    "photos:home": "tsx --conditions=react-server scripts/build-home-photos.ts",
    "brand:assets": "tsx --conditions=react-server scripts/build-brand-assets.ts",
    "dev:outbox": "tsx --conditions=react-server scripts/dev-outbox.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1164.0",
    "drizzle-orm": "0.45.4",
    "heic-decode": "2.1.0",
    "libphonenumber-js": "1.13.15",
    "markdown-it": "15.0.3",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "openid-client": "6.8.9",
    "postgres": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "use-intl": "4.14.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-plugin-i18next": "6.1.5",
    "exifr": "7.1.3",
    "oauth2-mock-server": "9.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
