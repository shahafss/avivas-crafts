# Copy to .env.local for development. No real secrets in this file.
# All local database URLs use port 5433 (see compose.yaml).

# --- Application ---
# development | test | staging | production
APP_ENV=development
# Public origin of the shop (no trailing slash).
APP_ORIGIN=http://localhost:3001
# Origin that serves public product images (the dev route /dev-images on the same origin locally).
IMAGE_PUBLIC_ORIGIN=http://localhost:3001
# Reverse proxies in front of the app whose X-Forwarded-For hops are trusted (0 locally).
TRUSTED_PROXY_HOPS=0

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/avivas_crafts_dev
# Test-only: real PostgreSQL for `pnpm test:pg`.
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5433/avivas_crafts_test
# Test-only: database the Playwright run resets and uses.
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5433/avivas_crafts_e2e

# --- Secrets ---
# At least 32 bytes, base64. Generate: openssl rand -base64 32 (this one is for local use only).
SECRET_HMAC_KEY=bG9jYWwtZGV2LW9ubHktaG1hYy1rZXktMzItYnl0ZXMhIQ==

# --- Image storage ---
# fs (local folder) | r2 (Cloudflare R2, production)
STORAGE_DRIVER=fs
# Root of the fs driver and the fake payment provider's status files.
LOCAL_DATA_DIR=.data
# Only with STORAGE_DRIVER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=
R2_BUCKET_PUBLIC=
# eu | default
R2_JURISDICTION=eu

# --- Email ---
# outbox (rows only, nothing is sent; read with `pnpm dev:outbox`) | resend
EMAIL_DRIVER=outbox
EMAIL_FROM=shop@example.test
# Only with EMAIL_DRIVER=resend:
RESEND_API_KEY=

# --- Payments ---
# fake (local fake payment page) | payplus | none
# `none`: no card payment, offline only; production's value at launch.
PAYMENT_PROVIDER=fake
# Only with PAYMENT_PROVIDER=payplus:
PAYPLUS_BASE_URL=
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
# Host of the hosted payment page (added to the CSP form-action).
PAYPLUS_PAYMENT_HOST=

# --- Admin sign-in (Google OIDC; the only step: a user with role `admin` signs in with Google) ---
# Roles are set with `pnpm admin:role <email> <admin|user>`.
# Locally, run `pnpm dev:oidc` (mock issuer) and use its URL. Production: https://accounts.google.com
OIDC_ISSUER=http://localhost:4011
GOOGLE_CLIENT_ID=local-google-client-id
GOOGLE_CLIENT_SECRET=local-google-client-secret

# --- Test hooks (never in production) ---
# Enables an optional cookie category for consent tests, e.g. analytics.
# CONSENT_TEST_CATEGORY=
